{
  "name": "inkra",
  "version": "0.1.0",
  "description": "Hand-drawn React controls with native semantics and deterministic decoration.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkrajs/inkra.git",
    "directory": "packages/inkra"
  },
  "homepage": "https://inkrajs.github.io/",
  "bugs": { "url": "https://github.com/inkrajs/inkra/issues" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./PencilSurface": {
      "types": "./dist/PencilSurface.d.ts",
      "import": "./dist/PencilSurface.js",
      "default": "./dist/PencilSurface.js"
    },
    "./PencilText": {
      "types": "./dist/PencilText.d.ts",
      "import": "./dist/PencilText.js",
      "default": "./dist/PencilText.js"
    },
    "./PencilIcon": {
      "types": "./dist/PencilIcon.d.ts",
      "import": "./dist/PencilIcon.js",
      "default": "./dist/PencilIcon.js"
    },
    "./PencilLine": {
      "types": "./dist/PencilLine.d.ts",
      "import": "./dist/PencilLine.js",
      "default": "./dist/PencilLine.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "Yozai-OFL.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "react",
    "components",
    "hand-drawn",
    "pencil",
    "accessible"
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/geojson": "^7946.0.16",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.60.0",
    "react-day-picker": "^9.14.0"
  }
}
