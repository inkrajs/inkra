{
  "name": "inkra-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-docs.mjs",
    "build": "npm run build --workspace=@inkra/react",
    "test": "npm test --workspace=@inkra/react",
    "test:release": "node --test scripts/test/*.test.mjs",
    "test:components:plan": "node scripts/plan-component-tests.mjs",
    "test:components:run": "node scripts/run-component-tests.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:installed": "node scripts/check-installed.mjs",
    "check:contracts": "npm run check:repository && npm run test:release && npm run build && npm run check:package && npm run check:installed",
    "check": "npm run check:repository && npm run test:release && npm test && npm run check:package && npm run check:installed"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "react-test-renderer": "19.3.1"
  }
}
